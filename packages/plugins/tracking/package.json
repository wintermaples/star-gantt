{
  "name": "@stargantt/plugin-tracking",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Official StarGantt plugin (opt-in): baselines and slip, progress tracking, resource-rate cost accounting, and earned-value management.",
  "keywords": [
    "gantt",
    "gantt-chart",
    "project-management",
    "timeline",
    "scheduling",
    "typescript",
    "plugin-architecture",
    "zero-dependencies"
  ],
  "author": "wintermaples",
  "homepage": "https://wintermaples.github.io/star-gantt/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wintermaples/star-gantt.git",
    "directory": "packages/plugins/tracking"
  },
  "bugs": "https://github.com/wintermaples/star-gantt/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@stargantt/core": "workspace:*",
    "@stargantt/sdk": "workspace:*"
  },
  "devDependencies": {
    "@stargantt/plugin-data-store": "workspace:*",
    "@stargantt/plugin-resource": "workspace:*",
    "@stargantt/plugin-task-bars": "workspace:*",
    "@stargantt/plugin-tree-grid": "workspace:*",
    "@stargantt/plugin-view": "workspace:*"
  },
  "main": "./dist/tracking.umd.js",
  "module": "./dist/tracking.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tracking.js",
      "default": "./dist/tracking.umd.js"
    }
  },
  "files": [
    "dist"
  ]
}
