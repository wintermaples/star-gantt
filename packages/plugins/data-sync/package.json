{
  "name": "@stargantt/plugin-data-sync",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Official StarGantt plugin (opt-in): REST/GraphQL snapshots with delta sync and optimistic write-back, lazy paged loading, IndexedDB offline snapshots, and realtime transport application.",
  "keywords": [
    "gantt",
    "gantt-chart",
    "project-management",
    "timeline",
    "scheduling",
    "typescript",
    "plugin-architecture",
    "zero-dependencies"
  ],
  "author": "wintermaples",
  "homepage": "https://wintermaples.github.io/star-gantt/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wintermaples/star-gantt.git",
    "directory": "packages/plugins/data-sync"
  },
  "bugs": "https://github.com/wintermaples/star-gantt/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@stargantt/core": "workspace:*"
  },
  "main": "./dist/data-sync.umd.js",
  "module": "./dist/data-sync.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/data-sync.js",
      "default": "./dist/data-sync.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@stargantt/plugin-data-store": "workspace:*",
    "@stargantt/plugin-interaction": "workspace:*",
    "@stargantt/plugin-tree-grid": "workspace:*",
    "@stargantt/plugin-view": "workspace:*",
    "@stargantt/sdk": "workspace:*"
  }
}
