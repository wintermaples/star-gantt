{
  "name": "@stargantt/plugin-undo-redo",
  "version": "0.0.1",
  "license": "MIT",
  "description": "Official StarGantt plugin: records every applied transaction and replays it in reverse on undo, forward again on redo.",
  "keywords": [
    "gantt",
    "gantt-chart",
    "project-management",
    "timeline",
    "scheduling",
    "typescript",
    "plugin-architecture",
    "zero-dependencies"
  ],
  "author": "wintermaples",
  "homepage": "https://wintermaples.github.io/star-gantt/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wintermaples/star-gantt.git",
    "directory": "packages/plugins/undo-redo"
  },
  "bugs": "https://github.com/wintermaples/star-gantt/issues",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@stargantt/core": "workspace:*",
    "@stargantt/plugin-data-store": "workspace:*"
  },
  "devDependencies": {
    "@stargantt/plugin-a11y": "workspace:*",
    "@stargantt/sdk": "workspace:*"
  },
  "main": "./dist/undo-redo.umd.js",
  "module": "./dist/undo-redo.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/undo-redo.js",
      "default": "./dist/undo-redo.umd.js"
    }
  },
  "files": [
    "dist"
  ]
}
