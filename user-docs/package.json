{
  "name": "@stargantt/user-docs",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "StarGantt user documentation site. Standalone Vite app — deliberately outside the pnpm workspace so its third-party dependencies can never be mistaken for library runtime dependencies.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p e2e --noEmit",
    "generate": "node tools/extract-api.ts && node tools/extract-tokens.ts && node tools/build-content-index.ts",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sucrase": "^3.35.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
